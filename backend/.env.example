# BERSEKA Backend — konfigurasi environment (Backlog 7)
# Copy ke .env dan sesuaikan sebelum menjalankan `npm start`.

# "fastapi" (default, panggil Model Serving API Backlog 6) atau "mock" (testing tanpa FastAPI)
WASTE_AI_ADAPTER=fastapi

# Wajib diisi jika WASTE_AI_ADAPTER=fastapi
WASTE_AI_API_BASE_URL=http://127.0.0.1:8000

# Opsional, default 15000ms
WASTE_AI_TIMEOUT_MS=15000

# Path file database SQLite (dibuat otomatis jika belum ada)
SCAN_DB_PATH=./data/scans.db

PORT=4000

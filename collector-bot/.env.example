# =============================================================================
# BERSEKA Collector Bot - environment config
#
# SALIN file ini ke ".env" (JANGAN commit .env ke git) lalu isi nilainya.
# .env sudah ada di .gitignore proyek ini.
# =============================================================================

# --- Telegram ---
# Dapatkan dari @BotFather setelah membuat bot BARU (lihat README.md).
# WAJIB token BARU khusus collector bot ini - JANGAN reuse token dari sistem lain.
TELEGRAM_BOT_TOKEN=

# --- Storage mode ---
# "r2"    = upload ke Cloudflare R2 (rekomendasi untuk produksi / go-live)
# "local" = simpan ke folder lokal collector-bot/uploads/ (SEMENTARA/dev only,
#           disk VPS gateway terbatas ~19GB, JANGAN dipakai untuk volume nyata
#           dari 32 kelompok - lihat README.md bagian "Storage")
STORAGE_MODE=local

# --- Cloudflare R2 (S3-compatible) ---
# Kosongkan semua & biarkan STORAGE_MODE=local jika R2 belum di-provision.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=berseka-collector-photos
R2_ENDPOINT=
# contoh R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Lokal fallback ---
LOCAL_UPLOAD_DIR=./uploads

# --- Data / manifest ---
MANIFEST_PATH=./data/manifest.jsonl

# --- Konfigurasi kelompok ---
GROUPS_CONFIG_PATH=./config/groups.json

[Unit]
Description=BERSEKA AI Collector Bot (Telegram photo intake - isolated from Hermes/gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=berseka-bot
Group=berseka-bot
WorkingDirectory=/opt/berseka-collector-bot
Environment=HOME=/opt/berseka-collector-bot
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection
EnvironmentFile=/opt/berseka-collector-bot/.env
ExecStart=/usr/bin/node /opt/berseka-collector-bot/src/bot.js
Restart=always
RestartSec=5
MemoryMax=256M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/berseka-collector-bot
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
